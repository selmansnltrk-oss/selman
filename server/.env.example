# Backend ONLY. Copy to server/.env. Do not commit credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
# Deployed HTTPS backend origin, no path. Not the storefront unless it hosts this API.
PUBLIC_ORIGIN=
# This site's Headless Settings > OAuth apps.
WIX_CLIENT_ID=
# Add PUBLIC_ORIGIN/auth/callback as authorized redirect URI in that OAuth app.
WIX_SITE_ID=ece5420a-0b61-4879-8872-0e899f7628b5
# Generate once; retain in your host's secret manager:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_DATA_KEY=
DATABASE_PATH=./data/membership.sqlite
ALLOW_LOCAL_HTTP=false
